generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?   @unique
  password  String?
  createdAt DateTime @default(now())

  store     Store?
}

model Store {
  id         Int      @id @default(autoincrement())
  name       String
  categoryId String
  address    String
  area       String
  city       String
  pincode    String
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())

  userId     Int      @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
