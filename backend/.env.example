PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/storedata
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
CLIENT_URL=http://localhost:5173

# SMTP email verification and password reset delivery
# Gmail: smtp.gmail.com with port 587 (STARTTLS) is recommended for cloud hosts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
