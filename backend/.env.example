PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/storedata
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
CLIENT_URL=http://localhost:5173

# Resend email verification and password reset delivery
RESEND_API_KEY=
RESEND_FROM=Inventra <noreply@your-verified-domain.com>

# Optional Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
