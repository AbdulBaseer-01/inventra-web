# Expo exposes only variables prefixed with EXPO_PUBLIC_ to application code.
#
# Android emulator:
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
#
# Physical device: replace the value with your computer's LAN IP, for example:
# EXPO_PUBLIC_API_URL=http://192.168.1.25:5000
#
# Web or iOS simulator:
# EXPO_PUBLIC_API_URL=http://localhost:5000
